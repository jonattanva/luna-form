{
  "name": "luna-form",
  "description": "A monorepo for Luna, a form builder library based on JSON.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark": "pnpm exec tsx benchmark/form-build.bench.ts",
    "benchmark:interpolate": "pnpm exec tsx benchmark/interpolate.bench.ts",
    "benchmark:probes": "pnpm exec tsx benchmark/render/probes.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "knip": "knip",
    "lint": "turbo run lint",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "serve": "pnpm --filter react-luna-editor dev",
    "start": "pnpm --filter react-luna-editor start",
    "test:e2e": "pnpm playwright test --grep '@e2e'",
    "test:e2e:ui": "pnpm playwright test --grep '@e2e' --ui",
    "test:perf": "pnpm playwright test --grep '@perf' --project=chromium",
    "test:render": "pnpm playwright test --grep '@render' --project=chromium",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typescript": "turbo run typescript"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.12.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jotai": "2.20.3",
    "knip": "6.36.0",
    "lint-staged": "17.5.1",
    "mitata": "1.0.34",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonattanva/luna-form.git"
  },
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=11.x"
  }
}
