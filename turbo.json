{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig.json", "esbuild.mjs"],
      "outputs": ["dist/**"]
    },
    "typescript": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "src/**",
        "eslint.config.*",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/.config/eslint-*.mjs"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    }
  }
}
